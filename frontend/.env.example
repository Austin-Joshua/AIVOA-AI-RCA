# ==============================================================================
# AIVOA.AI — Frontend Environment Configuration Template
# ==============================================================================
# Copy this template to frontend/.env for custom local frontend development:
#   cp frontend/.env.example frontend/.env
#
# SECURITY NOTICE:
# All variables prefixed with VITE_ are exposed to the browser client bundle.
# NEVER place backend secrets (GROQ API keys, SECRET_KEY, database passwords) here.
# ==============================================================================

# Public API Base URL
# By default, Vite dev server proxies '/api' to http://127.0.0.1:8000.
# In production, nginx proxies '/api/' to http://backend:8000.
# Only uncomment and set this if you are serving the frontend from a different host or port:
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Demonstration Login UI Shortcuts
# Strictly excluded from production builds (import.meta.env.PROD).
# Set to 'false' in development if you wish to hide demonstration account buttons locally.
VITE_ENABLE_DEMO_LOGIN=true

