# ==============================================================================
# AIVOA.AI — Backend Environment Configuration Template
# ==============================================================================
# Copy this template to backend/.env and populate with deployment-specific credentials.
# NEVER commit backend/.env or any production credentials into Git.
# ==============================================================================

# Application Environment ('development', 'test', 'production')
ENVIRONMENT=development

# PostgreSQL 16 Database Connection String (Mandatory, fail-fast; SQLite is disabled)
# In production, specify strong credentials.
DATABASE_URL=postgresql+asyncpg://aivoa_user:your_secure_db_password_here@localhost:5432/aivoa_rca

# Groq LLM Inference Credentials
# Primary Groq API Key (format: gsk_...)
GROQ_API_KEY=your_primary_groq_api_key_here

# Optional Backup Groq API Key for Quota-Aware Failover
GROQ_BACKUP_API_KEY=your_backup_groq_api_key_here

# Optional Groq Project IDs (Required to permit 429 quota failover between separate projects)
GROQ_PROJECT_ID=
GROQ_BACKUP_PROJECT_ID=

# Active LLM Model Identifier (Defaults to llama-3.3-70b-versatile; auto-discovery is opt-in)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_AUTODISCOVER=false

# Authentication & Security
# SECRET_KEY is mandatory for all non-test environments (fail-fast enforced if unset, too short, or using placeholders)
# Generate a secure key via: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_cryptographically_secure_random_key_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Features (Strictly disabled in production; permitted only in 'development' and 'test')
ENABLE_DEMO_PROVISIONING=true
DEMO_ACCOUNT_PASSWORD=your_demo_password_here_min_8_chars

# File Upload and Storage
UPLOAD_DIR=uploads
EVIDENCE_STORAGE_DIR=storage/evidences
MAX_UPLOAD_SIZE_BYTES=10485760

# CORS Allowed Origins (Comma-separated; wildcards strictly forbidden with credentials)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Optional First Administrator Bootstrap (Out-of-band initialization only; clear after first boot)
# INITIAL_ADMIN_USERNAME=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_FULL_NAME=
