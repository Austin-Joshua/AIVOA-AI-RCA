# ==============================================================================
# AIVOA.AI — Docker Compose & Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting containers:
#   cp .env.example .env
# NEVER commit .env into Git.
# ==============================================================================

# Application Environment ('development', 'test', 'production')
ENVIRONMENT=development

# PostgreSQL 16 Credentials (Required by docker compose)
POSTGRES_USER=aivoa_user
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=aivoa_rca
POSTGRES_PORT=5432

# Database Connection URL (Constructed automatically by Compose if omitted)
# DATABASE_URL=postgresql+asyncpg://aivoa_user:replace_with_secure_postgres_password@localhost:5432/aivoa_rca

# Application Security (Mandatory for non-test execution; minimum 32 characters)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_cryptographically_secure_random_key_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Features (Strictly disabled in production; optional in development)
ENABLE_DEMO_PROVISIONING=true
ALLOW_DEMO_LOGIN=false

# AI Rate Limiting (per-user in-memory token bucket)
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_HOUR=200

# Groq LLM Inference
GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_BACKUP_API_KEY=
GROQ_PROJECT_ID=
GROQ_BACKUP_PROJECT_ID=
GROQ_MODEL=llama-3.3-70b-versatile

