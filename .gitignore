# ==============================================================================
# AIVOA.AI — Root .gitignore
# ==============================================================================

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment, Secrets, and Credential Configuration
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Local Databases and SQLite Artifacts
*.db
*.db-journal
*.sqlite
*.sqlite3
aivoa_rca.db
test_aivoa.db

# Python Bytecode, Caching, and Packaging
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Evidence and File Upload Storage
storage/
backend/storage/evidences/*
!backend/storage/evidences/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
uploads/


# Node.js, Frontend Dependencies, and Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.eslintcache
test-results/
frontend/test-results/
playwright-report/
frontend/playwright-report/

# Operating System and IDE Artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Antigravity Brain Scratch Files & Logs
scratch/

# Documentation Screenshots, Recordings, and Media Artifacts
docs/screens/
docs/screens/*.png
examples/
*.mp4
*.webm
*.mov
*.mkv
